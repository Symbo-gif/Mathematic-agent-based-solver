# Core paths
SYMBO_CONFIG_FILE=config.yaml
SYMBO_ENV=development

# Logging
SYMBO_LOG_LEVEL=INFO
SYMBO_LOG_JSON=true
SYMBO_LOG_FILE=logs/symbo.log

# Security / messaging
SYMBO_MESSAGE_KEY=change-me-hmac-key
SYMBO_PARSE_TIMEOUT=5.0

# Resource constraints (override config.yaml defaults)
SYMBO_HARDWARE_MAX_VRAM_GB=8.0
SYMBO_THRESHOLDS_VRAM_WARNING=0.85
SYMBO_TIMEOUTS_DEFAULT=60.0

# Paths
SYMBO_DATA_DIR=data
SYMBO_TRACES_DIR=data/traces
